		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"playwright-core": "^1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24.22.1"
	},
	"dependencies": {
		"maplibre-gl": "^6.16.0",
		"pmtiles": "^4.5.0"
